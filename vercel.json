{
  "functions": {
    "api/insosoe.js": {
      "maxDuration": 240
    },
    "api/payment.js": {
      "maxDuration": 90
    },
    "api/payment-webhook.js": {
      "maxDuration": 60
    },
    "api/payment-reconcile.js": {
      "maxDuration": 90
    },
    "api/qa-upgrade.js": {
      "maxDuration": 240
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://js.tosspayments.com; style-src 'self'; img-src 'self' data: https://*.tosspayments.com; connect-src 'self' https://*.tosspayments.com; frame-src https://*.tosspayments.com; font-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://*.tosspayments.com"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "regions": [
    "hnd1"
  ],
  "outputDirectory": "public",
  "framework": null,
  "crons": [
    {
      "path": "/api/payment-reconcile",
      "schedule": "*/10 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/payment/success",
      "destination": "/index.html"
    },
    {
      "source": "/payment/fail",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm test"
}
