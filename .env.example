AI_PROVIDER=openrouter
AI_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
# OIDC: @vercel/oidc at request time; stable SESSION_SECRET required.
SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# aliases KV_REST_API_URL / KV_REST_API_TOKEN
APP_ORIGIN=https://www.kkumsu.com
AI_DAILY_BUDGET_USD=1
AI_INPUT_USD_PER_MILLION=3
AI_OUTPUT_USD_PER_MILLION=15
AI_IP_DAILY_REQUESTS=100
AI_SESSION_DAILY_REQUESTS=60
AI_TIMEOUT_MS=30000
# Lifetime cap never resets automatically. Provider auto-top-up is not changed.
AI_TOTAL_BUDGET_USD=2

# Payment: keep disabled until the operational checklist is actually verified.
PAYMENT_MODE=disabled
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_MERCHANT_ID=
PAYMENT_READY=false
TOSS_MERCHANT_VERIFIED=false
PAYMENT_LEGAL_VERIFIED=false
PAYMENT_RECONCILIATION_READY=false
PAYMENT_SUPPORT_READY=false
CRON_SECRET=
BUSINESS_NAME=
BUSINESS_REPRESENTATIVE=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_ECOMMERCE_REGISTRATION=
BUSINESS_ADDRESS=
BUSINESS_CONTACT_EMAIL=
BUSINESS_CONTACT_PHONE=
PAYMENT_REFUND_POLICY=
PAYMENT_DELIVERY_TERMS=
PAYMENT_FINANCIAL_RETENTION_POLICY=
TERMS_URL=
PRIVACY_URL=
# Temporary Preview-only QA secret, remove with the QA route before production.
INSOSOE_QA_SECRET=
